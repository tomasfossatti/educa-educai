# Base de datos PostgreSQL (local con docker compose, o Supabase/Neon/RDS)
DATABASE_URL="postgresql://educai:educai@localhost:5432/educai"

# Proveedor de IA. Solo se usa del lado del servidor; nunca se expone al cliente.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Modelo por defecto para todas las operaciones (ver src/server/ai/config.ts).
AI_MODEL="claude-opus-5-5"
# Límite diario de mensajes al tutor por estudiante (control de costo).
AI_DAILY_TUTOR_MESSAGES=150

# Cookies de sesión seguras (true en producción detrás de HTTPS).
SESSION_COOKIE_SECURE=false
