# Base de datos PostgreSQL (local con docker compose, o Supabase/Neon/RDS)
DATABASE_URL="postgresql://educai:educai@localhost:5432/educai"

# Proveedor de IA: anthropic, deepseek, gemini, fallback (cadena de gratuitos) o scripted (tests).
AI_PROVIDER="anthropic"
# DeepSeek (uso provisorio). Modelos y precios en USD por millón de tokens, configurables.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_EXTRACTION_MODEL=""
DEEPSEEK_PRICE_INPUT=""
DEEPSEEK_PRICE_CACHE_HIT=""
DEEPSEEK_PRICE_OUTPUT=""
# Gemini de Google (plan gratuito, solo datos sintéticos). Precios en 0 salvo plan pago.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EXTRACTION_MODEL="gemini-3.5-flash-lite"
# Cadena de respaldo (AI_PROVIDER=fallback): orden y claves. Los que no tienen clave se saltean.
AI_FALLBACK_ORDER="groq,gemini,openrouter,deepseek,cerebras"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
CEREBRAS_API_KEY=""
# Espera máxima ante un límite por minuto antes de reintentar (ms).
AI_RATE_LIMIT_MAX_WAIT_MS=""
GEMINI_REASONING_EFFORT=""
GEMINI_PRICE_INPUT=""
GEMINI_PRICE_CACHE_HIT=""
GEMINI_PRICE_OUTPUT=""
ANTHROPIC_API_KEY=""
# Modelo por defecto para todas las operaciones (ver src/server/ai/config.ts).
AI_MODEL="claude-opus-5-5"
# Modelo del análisis en segundo plano (evidencia, señales, contexto). Más económico que el chat.
AI_EXTRACTION_MODEL="claude-sonnet-5-5"
# Límite diario de mensajes al tutor por estudiante (control de costo).
AI_DAILY_TUTOR_MESSAGES=150
# Tope semanal de gasto de IA por estudiante, en USD (0 lo desactiva). Frena chat, quiz y subidas.
AI_WEEKLY_STUDENT_CAP_USD=2
# Umbral de alerta del consumo total de la instalación por semana, en USD (solo avisa, no frena).
AI_WEEKLY_TOTAL_ALERT_USD=25
# Fracción del tope desde la que se avisa (al estudiante y por la alerta).
AI_BUDGET_ALERT_RATIO=0.8
# Webhook para las alertas de consumo (Slack o Discord). Es un secreto: va en las variables del proveedor.
AI_ALERT_WEBHOOK_URL=""

# Cookies de sesión seguras (true en producción detrás de HTTPS).
SESSION_COOKIE_SECURE=false

# Seed de demostración (solo local). Sin valor, la contraseña se genera en cada corrida.
SEED_DEMO_PASSWORD=""
# Permite el seed contra una base no local (solo staging, con datos sintéticos).
SEED_ALLOW_REMOTE=""

# Plazos de conservación en días (vacío = apagado; mínimo 30). Los decide Tomás con el abogado.
# Se aplican con: npm run retention -- --apply
RETENTION_CONVERSATION_DAYS=""
RETENTION_ACCESS_LOG_DAYS=""
RETENTION_AI_USAGE_DAYS=""
