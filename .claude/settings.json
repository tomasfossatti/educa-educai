{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git push origin *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh secret set *)",
      "Bash(gh variable set *)",
      "Bash(docker compose *)",
      "Bash(openssl rand *)",
      "Bash(psql *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)"
    ],
    "ask": [
      "Bash(npm run db:reset)",
      "Bash(npm run db:seed)",
      "Bash(npm install -g *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Read(./.env.production*)",
      "Read(./.secrets/prod/**)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(npm run db:push)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)"
    ]
  },
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  }
}
